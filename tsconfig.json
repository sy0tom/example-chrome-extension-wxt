{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "#": ["entrypoints"],
      "#/*": ["./entrypoints/*"],
      "~": ["."],
      "~/*": ["./*"]
      // "##": ["."],
      // "##/*": ["./*"],
      // "~~": ["."],
      // "~~/*": ["./*"]
    }
  },
  "include": ["./**/*", "./.wxt/wxt.d.ts"],
  "exclude": ["./.output", "./node_modules/"]
}
